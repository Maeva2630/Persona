      "id": "30191e21-8e14-4942-9836-186fd56dcaad",
      "name": "Loop Over Topics"
    },
    {
      "parameters": {
        "jsCode": "const uniqueTopics = new Set();\n\nfor (const item of $input.all()) {\n  const topicsString = item.json.topics;\n  \n  if (topicsString) {\n    const splitTopics = topicsString.toLowerCase().split(/,|\\sand\\s|\\set\\s/);\n    \n    for (const topic of splitTopics) {\n      let cleanedTopic = topic.trim();\n      cleanedTopic = cleanedTopic.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n      if (cleanedTopic.endsWith('s') && cleanedTopic.length > 3) {\n        cleanedTopic = cleanedTopic.slice(0, -1);\n      }\n      if (cleanedTopic !== \"\") {\n        uniqueTopics.add(cleanedTopic);\n      }\n    }\n  }\n}\n\nreturn Array.from(uniqueTopics).map(topic => {\n  return { json: { topic: topic } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
