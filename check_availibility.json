    {
      "parameters": {
        "jsCode": "const usernameCheck = $('Get Usernames').all();\nconst emailCheck = $('Get Emails').all();\n\nconst usernameExists = usernameCheck.some(item => item.json && item.json.id);\nconst emailExists = emailCheck.some(item => item.json && item.json.id);\n\nif (usernameExists) {\n  return [{ json: { available: false, reason: \"Username already exists\" }}];\n}\nif (emailExists) {\n  return [{ json: { available: false, reason: \"Email already in use\" }}];\n}\nreturn [{ json: { available: true }}];"
      },
